# AIOps assistant configuration
LLM_PROVIDER=mock                 # mock | ollama | lmstudio | openai | bedrock
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2

# GitHub (for CI/CD GitOps commits + human-in-the-loop issues)
GITHUB_USER=<your-github-username>
GITHUB_TOKEN=<your-github-pat>
GITHUB_REPO=<your-github-username>/aiops-project

# AWS (only needed when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-v2
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
